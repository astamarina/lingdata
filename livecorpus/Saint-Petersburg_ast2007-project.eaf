    <TIER ANNOTATOR="astamarina" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@ast2007f" PARTICIPANT="@ast2007f" TIER_ID="gestComment@ast2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2365" ANNOTATION_REF="a613">
                <ANNOTATION_VALUE>здесь ещё продолжение адаптора нервозности (пальцы)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2366" ANNOTATION_REF="a621">
                <ANNOTATION_VALUE>как будто движения головы туда-сюда указывают на то, что я бывала в нескольких местах (типа и там, и там...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2378" ANNOTATION_REF="a2175">
                <ANNOTATION_VALUE>может быть, тут мотание головой значит отрицание, то есть жест изобразительный</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2370" ANNOTATION_REF="a2180">
                <ANNOTATION_VALUE>я предполагаю, что у собеседника был похожий опыт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2371" ANNOTATION_REF="a2191">
                <ANNOTATION_VALUE>может, это прагматический со значением неточности, слабой выраженности</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2372" ANNOTATION_REF="a2208">
                <ANNOTATION_VALUE>мне кажется дальше (до 14:26:200) идёт не продолжение жеста, а просто смена позы на более удобную</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2373" ANNOTATION_REF="a2349">
                <ANNOTATION_VALUE>здесь ещё адаптор нервозности пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2374" ANNOTATION_REF="a2352">
                <ANNOTATION_VALUE>здесь ещё адаптор нервозности пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2375" ANNOTATION_REF="a2251">
                <ANNOTATION_VALUE>здесь ещё адаптор нервозности пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2376" ANNOTATION_REF="a2277">
                <ANNOTATION_VALUE>возможно, не нервозность, а просто смена позы на более удобную</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2377" ANNOTATION_REF="a2317">
                <ANNOTATION_VALUE>возможно, стоит разделить эти жесты на два (по разному направлению движения), но значение как будто одинаковое</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
